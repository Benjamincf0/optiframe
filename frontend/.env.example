# Copy to .env.local to override. Nothing needs to be set for local development.

# Dev server only: where Vite forwards /api requests (the backend's `uv run optiframe`).
API_PROXY_TARGET=http://127.0.0.1:8000

# Production build only: full base URL of the deployed backend API, e.g.
#   VITE_API_BASE_URL=https://api.optiframe.example/api
# Leave unset to use same-origin /api (dev proxy, or a host rewrite such as Vercel/Netlify `/api/*` → backend).
# If set to another origin, add the frontend's origin to the backend's OPTIFRAME_CORS_ORIGINS.
# VITE_API_BASE_URL=
