# Copy to .env (dev) or set as environment variables (prod). All variables are prefixed OPTIFRAME_.
OPTIFRAME_ENV=dev
# Dev only: save lens photos that fail measurement (filename includes the error code)
# OPTIFRAME_DEBUG_DUMP_DIR=./debug-dumps
# Bind address for `uv run optiframe` (the Dockerfile binds 0.0.0.0 itself)
OPTIFRAME_HOST=127.0.0.1
OPTIFRAME_PORT=8000
# Required in prod: 32+ random chars. Signs JWTs, order links and design signatures; rotating it
# invalidates sessions, existing order links and not-yet-ordered generated STLs.
OPTIFRAME_SECRET_KEY=
# Empty disables /api/admin/*
OPTIFRAME_ADMIN_API_KEY=
# JSON list
OPTIFRAME_CORS_ORIGINS=["http://localhost:5173"]
OPTIFRAME_FRONTEND_URL=http://localhost:5173
OPTIFRAME_DATABASE_URL=sqlite:///./optiframe.db
# Must be persistent storage in prod (order STLs live here)
OPTIFRAME_STORAGE_DIR=./storage
OPTIFRAME_SPONSORSHIP_ENABLED=false
OPTIFRAME_CURRENCY=EUR
OPTIFRAME_SHIPPING_FLAT=6.90
# console | smtp
OPTIFRAME_MAILER=console
OPTIFRAME_MAIL_FROM=OptiFrame <orders@example.org>
OPTIFRAME_SMTP_HOST=
OPTIFRAME_SMTP_PORT=587
OPTIFRAME_SMTP_USER=
OPTIFRAME_SMTP_PASSWORD=
# Tuning
OPTIFRAME_MAX_CONCURRENT_JOBS=2
OPTIFRAME_SEGMENTATION_RUNS=2
OPTIFRAME_RATE_LIMIT_PER_MINUTE=20
